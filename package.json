{
  "name": "kapruka-playwright-framework",
  "version": "1.0.0",
  "description": "Enterprise Playwright TypeScript automation framework for kapruka.com",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:sanity": "playwright test --grep @sanity",
    "test:cart": "playwright test --grep @cart",
    "test:search": "playwright test --grep @search",
    "test:login": "playwright test --grep @login",
    "report": "playwright show-report reports/html-report",
    "codegen": "playwright codegen https://www.kapruka.com",
    "trace": "playwright show-trace"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.19.43",
    "allure-playwright": "^3.10.2",
    "dotenv": "^16.6.1",
    "typescript": "^5.4.0",
    "winston": "^3.13.0"
  },
  "dependencies": {
    "csv-parse": "^7.0.1",
    "json-parse": "^1.0.3"
  }
}
